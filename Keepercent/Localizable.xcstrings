        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer. Si este jugador tiene tiros registrados, no se eliminará y se explicará el motivo."
          }
        }
      }
    },
    "This can't be undone. Recording it again is the only way back." : {
      "localizations" : {
        "es" : {
